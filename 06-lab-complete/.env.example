# Sao chép thành .env rồi điền giá trị thật:  cp .env.example .env
# KHÔNG commit file .env. Trên cloud, đặt các biến này trong dashboard của nền tảng.

PORT=8000
ENVIRONMENT=development

# Key client phải gửi trong header X-API-Key. Tạo ngẫu nhiên: openssl rand -hex 24
AGENT_API_KEY=change-me

# Docker Compose tự ghi đè thành redis://redis:6379/0
REDIS_URL=redis://localhost:6379/0

RATE_LIMIT_PER_MINUTE=10
DAILY_BUDGET_USD=1.0
MONTHLY_BUDGET_USD=30.0
